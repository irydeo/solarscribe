            <item row="3" column="1">
             <widget class="QLabel" name="sunDecValue">
              <property name="text">
               <string>--</string>
              </property>
              <property name="toolTip">
               <string>How far the Sun is north or south of the equator, in degrees. It follows the seasons.</string>
