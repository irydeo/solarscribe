              <property name="text">
               <string>Stop the measurement</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="polarHint">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>The assistant subtracts the Sun's own motion from the measured drift. A second measurement confirms the first one; the step is done when the two agree.</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="polarSpacer">
