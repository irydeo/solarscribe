       <item>
        <widget class="QLabel" name="profileCaption">
         <property name="text">
          <string>Profile</string>
         </property>
         <property name="toolTip">
          <string>A profile stores the optics, the camera and the ROI presets for one instrument setup. The active profile is loaded at startup.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="profileCombo">
