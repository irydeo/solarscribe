            <item>
             <widget class="QLabel" name="polarTitle">
              <property name="role" stdset="0">
               <string>title</string>
              </property>
              <property name="text">
               <string>Polar alignment</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="polarWhy">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Polaris is not visible by day, so the Sun itself is the reference. The assistant samples the Sun's drift and tells you which screw to turn. It is precise because it is slow: 20 to 40 minutes separates the azimuth error from the altitude error.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="polarWhenLabel">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Best moment: measure altitude near the meridian, and azimuth towards the east or the west.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="polarLiveBox">
              <property name="title">
               <string>Live measurement</string>
              </property>
              <layout class="QGridLayout" name="polarLiveLayout">
               <item row="0" column="0">
                <widget class="QLabel" name="polarStateCaption">
                 <property name="text">
                  <string>State</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QLabel" name="polarStateValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not started</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="polarAzCaption">
                 <property name="text">
                  <string>Azimuth error</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLabel" name="polarAzValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not measured yet</string>
                 </property>
                 <property name="toolTip">
                  <string>How far the mount points east or west of the pole, in arcminutes. Turning the azimuth screw by this amount brings the drift line onto the pole.</string>
                 </property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel" name="polarAltCaption">
                 <property name="text">
                  <string>Altitude error</string>
                 </property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QLabel" name="polarAltValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not measured yet</string>
                 </property>
                 <property name="toolTip">
                  <string>How far the mount points above or below the pole, in arcminutes. It needs a measurement near the meridian to be trustworthy.</string>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QProgressBar" name="polarProgress">
              <property name="value">
               <number>0</number>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="polarStartButton">
              <property name="primary" stdset="0">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Start the measurement</string>
              </property>
              <property name="toolTip">
               <string>Samples the Sun's Dec every few minutes. Leave the telescope tracking and do not touch it while the measurement runs.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="polarSecondButton">
              <property name="text">
               <string>Take the confirmation measurement</string>
