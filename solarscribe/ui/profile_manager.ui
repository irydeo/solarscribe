   <item>
    <widget class="QLabel" name="profileManagerHint">
     <property name="role" stdset="0">
      <string>hint</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>A profile stores the optics, the camera and the ROI presets for one instrument setup. The active profile is loaded at startup; switching profiles does not move the telescope or restart the camera.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QListWidget" name="profileList">
     <property name="toolTip">
      <string>The saved profiles. The active one is marked. Select a name to rename, delete or use it.</string>
     </property>
    </widget>
   </item>
