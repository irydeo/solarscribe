         </property>
        </widget>
       </item>
       <item>
        <widget class="QToolButton" name="profileSaveButton">
         <property name="text">
          <string>Save as…</string>
         </property>
         <property name="toolTip">
          <string>Stores the current optics, camera and ROI presets under a new profile name and makes it active.</string>
         </property>
