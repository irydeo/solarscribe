        <item>
         <widget class="QStackedWidget" name="sideStack">
          <widget class="QWidget" name="findPage">
           <layout class="QVBoxLayout" name="findLayout">
            <property name="spacing">
             <number>4</number>
            </property>
            <property name="leftMargin">
             <number>0</number>
            </property>
            <property name="topMargin">
             <number>0</number>
