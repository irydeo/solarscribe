            <item>
             <widget class="QLabel" name="findTitle">
              <property name="role" stdset="0">
               <string>title</string>
              </property>
              <property name="text">
               <string>Find the Sun</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="findWhy">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>The Sun has to sit on the slit before anything can be measured. The app computes where the Sun is from your observatory position; the telescope panel on the right lets you nudge it by hand.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="findLiveBox">
              <property name="title">
               <string>Live reading</string>
              </property>
              <layout class="QGridLayout" name="findLiveLayout">
               <item row="0" column="0">
                <widget class="QLabel" name="sunCaption">
                 <property name="text">
                  <string>Sun on the slit</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QLabel" name="sunStateValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not measured yet</string>
                 </property>
                 <property name="toolTip">
                  <string>Measured from the bright fraction of the frame. A missing Sun means the spectrum is dark and the scan cannot start.</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="decCaption">
                 <property name="text">
                  <string>Dec error</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLabel" name="decErrorValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not measured yet</string>
                 </property>
                 <property name="toolTip">
                  <string>How far the Sun is from the slit centre, in arcseconds. Close to zero means the slit crosses the middle of the disk; a large error cuts the scan short.</string>
                 </property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel" name="slitCaption">
                 <property name="text">
                  <string>Slit signal</string>
                 </property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QLabel" name="slitValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not measured yet</string>
                 </property>
                 <property name="toolTip">
                  <string>How much light is reaching the slit, as a fraction of the brightest possible frame. Too low means the Sun is off the slit or the exposure is short.</string>
                 </property>
                </widget>
               </item>
               <item row="3" column="0">
                <widget class="QLabel" name="deadZoneCaption">
                 <property name="text">
                  <string>Centring limit</string>
                 </property>
                </widget>
               </item>
               <item row="3" column="1">
                <widget class="QLabel" name="deadZoneValue">
                 <property name="state" stdset="0">
                  <string>muted</string>
                 </property>
                 <property name="text">
                  <string>Not measured yet</string>
                 </property>
                 <property name="toolTip">
                  <string>How close to the centre the method can resolve, in arcseconds. Near the centre the bright-fraction signal is flat, and the chord length has zero slope there, so the coarse centring cannot do better than this. The fine centring in the Scanning step finishes the job; this figure says how much is left for it.</string>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="findPrimaryButton">
              <property name="primary" stdset="0">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Point at the Sun and centre</string>
              </property>
              <property name="toolTip">
               <string>Moves the telescope to the Sun's computed position and then centres it on the slit. It needs a connected mount and your observatory position.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="findStopButton">
              <property name="danger" stdset="0">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Stop the telescope</string>
              </property>
              <property name="toolTip">
               <string>Stops every axis at once. Use it whenever the telescope is moving somewhere you did not intend.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="findHint">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>The coarse centring uses the bright fraction of the frame. Near the centre it is flat, so it gets you close and the Scanning step finishes the job.</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="findSpacer">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>40</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </widget>
          <widget class="QWidget" name="polarPage">
