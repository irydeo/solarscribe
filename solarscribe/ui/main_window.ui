             </widget>
            </item>
            <item>
             <widget class="QLabel" name="scanWhy">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>One sweep writes one SER per row. The preparation centres the Sun on the slit and calibrates the sweep rate; then the scan runs. You can pause and recentre at any time, and the frames already written are kept.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="planBox">
              <property name="title">
               <string>What will run</string>
              </property>
              <layout class="QGridLayout" name="planLayout">
               <item row="0" column="0">
                <widget class="QLabel" name="planModeCaption">
                 <property name="text">
                  <string>Mode</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QComboBox" name="planModeCombo">
                 <property name="toolTip">
                  <string>A simple scan sweeps once. A mosaic sweeps several rows to cover a taller disk; it takes proportionally longer.</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="planCyclesCaption">
                 <property name="text">
                  <string>Cycles</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QSpinBox" name="planCyclesSpin">
                 <property name="minimum">
                  <number>1</number>
                 </property>
                 <property name="maximum">
                  <number>20</number>
                 </property>
                 <property name="value">
                  <number>3</number>
                 </property>
                 <property name="toolTip">
                  <string>Scans per session. Three lets you reject a bad take without doubling the session time.</string>
                 </property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel" name="planRowsCaption">
                 <property name="text">
                  <string>Rows</string>
                 </property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QSpinBox" name="planRowsSpin">
                 <property name="minimum">
                  <number>1</number>
                 </property>
                 <property name="maximum">
                  <number>20</number>
                 </property>
                 <property name="value">
                  <number>1</number>
                 </property>
                 <property name="toolTip">
                  <string>Rows of a mosaic. One row is a simple scan; more rows cover a bigger part of the disk.</string>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="planSummary">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>The plan appears here before the scan runs: rows, sweep rate and expected duration.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="recenterCheck">
              <property name="text">
               <string>Recentre between cycles</string>
              </property>
              <property name="checked">
               <bool>false</bool>
              </property>
              <property name="toolTip">
               <string>Before every cycle after the first, the app centres the Sun on the slit again. It costs a few minutes per session but stops the drift from cutting the later sweeps; the RA rewind happens either way.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="prepareButton">
              <property name="text">
               <string>Prepare the scan</string>
              </property>
              <property name="toolTip">
               <string>Centres the Sun finely and calibrates the sweep rate. It needs a clear view of the limb and the telescope tracking.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="scanPrimaryButton">
              <property name="primary" stdset="0">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Start the scan</string>
              </property>
              <property name="toolTip">
               <string>Runs the cycles in order. Every row is a SER file in the session folder; stopping keeps the frames already written.</string>
              </property>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="scanButtonRow">
              <item>
               <widget class="QPushButton" name="scanPauseButton">
                <property name="text">
                 <string>Pause</string>
                </property>
                <property name="enabled">
                 <bool>false</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="scanAbortButton">
                <property name="danger" stdset="0">
                 <bool>true</bool>
                </property>
                <property name="text">
                 <string>Stop the scan</string>
                </property>
                <property name="enabled">
                 <bool>false</bool>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <widget class="QProgressBar" name="scanProgressBar">
              <property name="value">
               <number>0</number>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="scanStatusValue">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Not started.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="scanDroppedValue">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Dropped frames: none so far. Every dropped frame is a gap in the SER that the reconstruction has to bridge.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="scanResultValue">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>When a scan finishes, its result and the session folder appear here.</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="scanSpacer">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="reopenStepButton">
          <property name="text">
           <string>Reopen this step</string>
          </property>
          <property name="toolTip">
           <string>Marks this completed step as in progress again. The numbers already saved are kept, so you can correct one thing without redoing the session.</string>
          </property>
          <property name="visible">
           <bool>false</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="videoPanel">
       <layout class="QVBoxLayout" name="videoLayout">
        <property name="spacing">
         <number>6</number>
        </property>
        <property name="leftMargin">
         <number>0</number>
        </property>
        <property name="topMargin">
         <number>0</number>
        </property>
        <property name="rightMargin">
         <number>0</number>
        </property>
        <property name="bottomMargin">
         <number>0</number>
        </property>
        <item>
         <layout class="QHBoxLayout" name="viewerToolbar">
          <property name="spacing">
           <number>6</number>
          </property>
          <item>
           <widget class="QLabel" name="stretchCaption">
            <property name="text">
             <string>Brightness</string>
            </property>
            <property name="toolTip">
             <string>How the 16 bit frame is mapped to the screen. Stretching affects what you see, never the SER.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="stretchCombo">
            <property name="toolTip">
             <string>How the 16 bit frame is mapped to the screen. Stretching affects what you see, never the SER.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="zoomCaption">
            <property name="text">
             <string>Zoom</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QSpinBox" name="zoomSpin">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>8</number>
            </property>
            <property name="value">
             <number>1</number>
            </property>
            <property name="toolTip">
             <string>Magnifies the video. It changes only the view: the ROI coordinates stay in frame pixels.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="gridCheck">
            <property name="text">
             <string>Grid</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="crossCheck">
            <property name="text">
             <string>Slit cross</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="toolTip">
             <string>Marks the centre of the slit. The Sun should be centred on this cross before a scan.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="roiCheck">
            <property name="text">
             <string>ROI</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="toolTip">
             <string>Shows the capture ROI and the spectral band over the video. Drag the handles to edit them.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="fitButton">
            <property name="text">
             <string>Fit</string>
            </property>
            <property name="toolTip">
             <string>Fits the whole frame in the view. It also resets the zoom to 1x.</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="viewerToolbarSpacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QLabel" name="viewerHint">
            <property name="role" stdset="0">
             <string>hint</string>
            </property>
            <property name="text">
             <string>Scroll to zoom, drag the handles to move the ROI</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QWidget" name="viewerHost" native="true">
          <property name="minimumSize">
           <size>
            <width>0</width>
            <height>200</height>
           </size>
          </property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>1</horstretch>
            <verstretch>1</verstretch>
           </sizepolicy>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSplitter" name="analysisSplitter">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="childrenCollapsible">
           <bool>false</bool>
          </property>
          <widget class="QGroupBox" name="magnifierBox">
           <property name="title">
            <string>Spectrum magnifier</string>
           </property>
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>90</height>
            </size>
           </property>
           <layout class="QVBoxLayout" name="magnifierLayout">
            <property name="spacing">
             <number>4</number>
            </property>
            <item>
             <widget class="QWidget" name="magnifierHost" native="true">
              <property name="minimumSize">
               <size>
                <width>0</width>
                <height>70</height>
               </size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="magnifierHint">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="text">
               <string>Zoomed view of the spectral band: the slit image and the absorption lines must be straight and centred.</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
          <widget class="QGroupBox" name="histogramBox">
           <property name="title">
            <string>Brightness histogram</string>
           </property>
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>90</height>
            </size>
           </property>
           <layout class="QVBoxLayout" name="histogramLayout">
            <property name="spacing">
             <number>4</number>
            </property>
            <item>
             <widget class="QWidget" name="histogramHost" native="true">
              <property name="minimumSize">
               <size>
                <width>0</width>
                <height>70</height>
               </size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="histogramHint">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="text">
               <string>The two markers are the stretch limits: below the first and above the second everything is clipped to black or white.</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="scanResultBox">
          <property name="title">
           <string>Scan progress and result</string>
          </property>
          <property name="minimumSize">
           <size>
            <width>0</width>
            <height>130</height>
           </size>
          </property>
          <layout class="QHBoxLayout" name="scanResultLayout">
           <property name="spacing">
            <number>8</number>
           </property>
           <item>
            <widget class="QWidget" name="scanViewHost" native="true">
             <property name="minimumSize">
              <size>
               <width>320</width>
               <height>130</height>
              </size>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QVBoxLayout" name="reconLayout">
             <property name="spacing">
              <number>3</number>
             </property>
             <item>
              <widget class="QLabel" name="reconCaption">
               <property name="role" stdset="0">
                <string>subtitle</string>
               </property>
               <property name="text">
                <string>Quick recon, screen only</string>
               </property>
               <property name="toolTip">
                <string>A light reconstruction to check the take. It is not exported and it does not replace post-processing.</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QWidget" name="reconHost" native="true">
               <property name="minimumSize">
                <size>
                 <width>220</width>
                 <height>86</height>
                </size>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="reconMessage">
               <property name="role" stdset="0">
                <string>hint</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="text">
                <string>The preview appears as the scan advances.</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="reconDisclaimer">
               <property name="role" stdset="0">
                <string>hint</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="text">
                <string>A light, non-authoritative preview: the band averaged and stacked into a disk. It is not calibrated, not exported and not a substitute for post-processing.</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="openSessionButton">
               <property name="text">
                <string>Open session folder</string>
               </property>
               <property name="toolTip">
                <string>Opens the folder that holds the SER files and the logs of this session, so the post-processing can pick them up.</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
