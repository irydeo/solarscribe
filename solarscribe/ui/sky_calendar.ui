            </item>
            <item row="1" column="1">
             <widget class="QLabel" name="sunDiameterValue">
              <property name="text">
               <string>--</string>
              </property>
              <property name="toolTip">
               <string>How wide the Sun looks today, in arcminutes. It changes with the Earth-Sun distance and decides how long the sweep has to be.</string>
              </property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="sunRaCaption">
              <property name="text">
               <string>Right ascension</string>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QLabel" name="sunRaValue">
              <property name="text">
               <string>--</string>
              </property>
              <property name="toolTip">
               <string>Where the Sun is on the celestial equator, in hours. It is what the GOTO uses.</string>
