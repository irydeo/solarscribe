      <string>hint</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="visible">
      <bool>false</bool>
     </property>
     <property name="text">
      <string>Named-profile storage is not available in this build; the single 'Default' profile is used.</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="profileEditRow">
     <item>
      <widget class="QPushButton" name="profileNewButton">
       <property name="text">
        <string>New from current</string>
       </property>
       <property name="toolTip">
        <string>Saves the current optics, camera and ROI presets under a new name. The new profile becomes active.</string>
