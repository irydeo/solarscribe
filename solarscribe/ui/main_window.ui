                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QSpinBox" name="bandX">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                </widget>
               </item>
               <item row="0" column="2">
                <widget class="QLabel" name="bandWCaption">
                 <property name="text">
                  <string>Width</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="3">
                <widget class="QSpinBox" name="bandW">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="bandYCaption">
                 <property name="text">
                  <string>Y</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QSpinBox" name="bandY">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                </widget>
               </item>
               <item row="1" column="2">
                <widget class="QLabel" name="bandHCaption">
                 <property name="text">
                  <string>Height</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="3">
                <widget class="QSpinBox" name="bandH">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="tiltRow">
              <item>
               <widget class="QLabel" name="tiltCaption">
                <property name="text">
                 <string>Tilt</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QLabel" name="tiltValue">
                <property name="role" stdset="0">
                 <string>number</string>
                </property>
                <property name="text">
                 <string>Not measured</string>
                </property>
                <property name="toolTip">
                 <string>How far the spectral line leans across the frame, in degrees and in pixels of drift. A tilted line skews the reconstruction and needs a taller ROI.</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="roiMeasureButton">
                <property name="text">
                 <string>Measure tilt</string>
                </property>
                <property name="toolTip">
                 <string>Fits a line to the slit edge of the current frame. If the edge is not straight, the app says so instead of showing a number.</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <widget class="QLabel" name="roiRateValue">
              <property name="role" stdset="0">
               <string>number</string>
              </property>
              <property name="text">
               <string>Rate: not estimated</string>
              </property>
              <property name="toolTip">
               <string>Estimated frames per second and data rate of this ROI. It must reach the target rate, or the scan will be too slow to finish before the Sun moves.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="roiScaleValue">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="text">
               <string>Scale: not available until the profile has the optics.</string>
              </property>
              <property name="toolTip">
               <string>Arcseconds of sky per camera pixel, from the profile focal length and pixel size. It turns the ROI's pixels into sky: the tilt drift and the mosaic row step are measured with it.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="roiWarnings">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>No problems found yet.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="roiApplyButton">
              <property name="primary" stdset="0">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Apply this ROI</string>
              </property>
              <property name="toolTip">
               <string>Sends the rectangles to the camera. The stream restarts with the new ROI; a recording in progress is closed cleanly first.</string>
              </property>
             </widget>
            </item>
