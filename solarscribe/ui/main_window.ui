            <item>
             <widget class="QLabel" name="roiTitle">
              <property name="role" stdset="0">
               <string>title</string>
              </property>
              <property name="text">
               <string>Capture ROI</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="roiWhy">
              <property name="role" stdset="0">
               <string>hint</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>The ROI is the strip the camera delivers. It sets the frame rate and exactly what is written to the SER, so it has to hold the spectrum with room for the tilt. Draw the spectral band on the video and type the capture rectangle: the frame is already the capture ROI, so a bigger rectangle drawn over it would be fiction.</string>
              </property>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="roiPresetRow">
              <item>
               <widget class="QComboBox" name="roiPresetCombo">
                <property name="toolTip">
                 <string>A preset saved for this camera and optic. Applying it restores both rectangles at once.</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="roiSavePresetButton">
                <property name="text">
                 <string>Save preset</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <widget class="QGroupBox" name="captureBox">
              <property name="title">
               <string>Capture ROI, sensor pixels</string>
              </property>
              <property name="toolTip">
               <string>The rectangle the camera reads out. Its width and height fix the frame rate and the SER size.</string>
              </property>
              <layout class="QGridLayout" name="captureLayout">
               <item row="0" column="0">
                <widget class="QLabel" name="capXCaption">
                 <property name="text">
                  <string>X</string>
                 </property>
                 <property name="toolTip">
                  <string>Left edge on the sensor, in binned pixels.</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QSpinBox" name="capX">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                 <property name="toolTip">
                  <string>Left edge on the sensor, in binned pixels.</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="2">
                <widget class="QLabel" name="capWCaption">
                 <property name="text">
                  <string>Width</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="3">
                <widget class="QSpinBox" name="capW">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                 <property name="toolTip">
                  <string>Width of the delivered frame. Wider means a lower frame rate and a bigger SER.</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="capYCaption">
                 <property name="text">
                  <string>Y</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QSpinBox" name="capY">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                 <property name="toolTip">
                  <string>Top edge on the sensor, in binned pixels.</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="2">
                <widget class="QLabel" name="capHCaption">
                 <property name="text">
                  <string>Height</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="3">
                <widget class="QSpinBox" name="capH">
                 <property name="maximum">
                  <number>20000</number>
                 </property>
                 <property name="toolTip">
                  <string>Height of the delivered frame. It must hold the spectral band plus the tilt drift.</string>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="bandBox">
              <property name="title">
               <string>Spectral band, frame pixels</string>
              </property>
              <property name="toolTip">
               <string>The useful strip of the dispersed spectrum inside the frame. If it does not fit, the order is clipped.</string>
              </property>
              <layout class="QGridLayout" name="bandLayout">
               <item row="0" column="0">
                <widget class="QLabel" name="bandXCaption">
                 <property name="text">
